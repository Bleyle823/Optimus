# Copy to .env. Never commit the copy.

# NEAR testnet
NEAR_NETWORK=testnet
NEAR_RPC=https://rpc.testnet.near.org
NEAR_ESCROW_ACCOUNT=
NEAR_FT_CONTRACT=wrap.testnet

# Named accounts (create on testnet, then paste here)
NEAR_GUEST_ACCOUNT=guest.testnet
NEAR_ROBOT_ACCOUNT=tiago.testnet
NEAR_PANTRY_ACCOUNT=pantry.testnet
NEAR_COURIER_ACCOUNT=courier.testnet

# Paths to key files produced by `python -m hotel.cli derive-key`
ROBOT_KEYFILE=keys/robot.json
GUEST_KEYFILE=keys/guest.json
PANTRY_KEYFILE=keys/pantry.json
COURIER_KEYFILE=keys/courier.json
ROBOT_FC_KEYFILE=keys/robot-function-call.json

# Intents (mainnet only; dry quote does not spend)
ONECLICK_URL=https://1click.chaindefuser.com/v0
INTENTS_JWT=
# Set 1 only after a dry quote matches max slippage in config/hotel.json
INTENTS_LIVE=0

# peaq Solana (mainnet; dry-run first)
PEAQ_DRY_RUN=1
PEAQ_LIVE=0
SOLANA_RPC=https://api.mainnet-beta.solana.com

# Agent Market
NEAR_AI_API_KEY=
AGENT_MARKET_BASE=https://market.near.ai
AGENT_MARKET_POLL_SEC=15

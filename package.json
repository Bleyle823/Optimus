{
  "name": "optimus",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint --if-present",
    "download-models": "tsx scripts/download-models.ts",
    "offline-check": "tsx scripts/offline-check.ts",
    "demo": "tsx scripts/demo.ts",
    "smoke-gateway": "tsx scripts/smoke-gateway.ts",
    "gateway": "pnpm --filter @optimus/gateway run start",
    "machine-agent": "pnpm --filter @optimus/machine-agent run start",
    "settlement": "pnpm --filter @optimus/settlement run start"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "bare-runtime",
      "@qvac/sdk",
      "@qvac/inference",
      "@qvac/llm-llamacpp",
      "@qvac/fabric"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e"
}

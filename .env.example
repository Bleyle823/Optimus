# QVAC
QVAC_MODEL=LLAMA_3_2_1B_INST_Q4_0
QVAC_ENABLED=1
QVAC_CONFIG_PATH=./qvac.config.json
QVAC_RPC_INIT_TIMEOUT_MS=120000
# Optional HTTP/local GGUF if the QVAC registry times out
# QVAC_FALLBACK_SRC=https://huggingface.co/unsloth/Llama-3.2-1B-Instruct-GGUF/resolve/b69aef112e9f895e6f98d7ae0949f72ff09aa401/Llama-3.2-1B-Instruct-Q4_0.gguf

# Gateway
GATEWAY_PORT=3030
GATEWAY_DID=did:peaq:gateway-local
GATEWAY_PRIVATE_KEY=
GATEWAY_PRICE_USDT=0.01
GATEWAY_DB_PATH=./data/gateway.json
GATEWAY_URL=http://127.0.0.1:3030

# Machine agent (offline LAN)
MACHINE_AGENT_PORT=4040
MACHINE_AGENT_URL=http://127.0.0.1:4040
MACHINE_ID=peaqos:machine:demo
MACHINE_WALLET_MNEMONIC=word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12
GATEWAY_PAYEE_ADDRESS=
MAX_PRICE_USDT=0.05
DAILY_CAP_USDT=1
ALLOWED_GATEWAY_DIDS=
AGENT_DB_PATH=./data/agent.json
CHAIN=sepolia

# NETWORK: WDK settlement (Sepolia test USDT)
SEPOLIA_RPC=https://sepolia.gateway.tenderly.co
USDT_CONTRACT=0xaA8E23Fb1079EA71e0a56F48a2aA51851D8433D0

# NETWORK: peaq (agung / Machine Markets)
PEAQ_MARKETS_URL=
PEAQ_MCR_API_URL=https://mcr.peaq.xyz
PEAQ_CACHE_DB=./data/peaq-cache.db

# Demo
OPTIMUS_OFFLINE=0
